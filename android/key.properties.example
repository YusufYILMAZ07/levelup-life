# Bu dosyayı android/key.properties olarak kopyala ve gerçek değerleri gir.
# android/key.properties .gitignore içindedir; asla commit edilmez.
#
# Üretim keystore'u oluştur (tek sefer, güvenli bir yerde sakla):
#   keytool -genkey -v -keystore ~/ceyyus-release.jks -storetype JKS \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias ceyyus
#
# storeFile MUTLAK yol olmalıdır (örn. /Users/<kullanici>/ceyyus-release.jks).
storePassword=change-me
keyPassword=change-me
keyAlias=ceyyus
storeFile=/absolute/path/to/ceyyus-release.jks
